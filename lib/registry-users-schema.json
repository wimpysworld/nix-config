{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Noughty user registry",
  "description": "User registry for noughty. Each key is a username.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "keyboard": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repeatRate": { "type": "integer", "minimum": 1 }
        }
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
