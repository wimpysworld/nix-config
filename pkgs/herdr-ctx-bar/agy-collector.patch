+def agy_cache_path(pane_id: str) -> Path | None:
+    if not pane_id:
+        return None
+    safe_id = "".join(
+        ch if (ch.isascii() and (ch.isalnum() or ch in ("-", "_"))) else "_"
+        for ch in pane_id
+    )
+    if not safe_id:
+        return None
+    cache_home = os.environ.get("XDG_CACHE_HOME", "").strip()
+    root = Path(cache_home).expanduser() if cache_home else Path.home() / ".cache"
+    return root / "agy-herdr" / f"{safe_id}.json"
+
+
+def collect_agy(pane: dict[str, Any]) -> tuple[int, int] | None:
+    pane_id = str(pane.get("pane_id") or "").strip()
+    path = agy_cache_path(pane_id)
+    if not path:
+        return None
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError, TypeError, ValueError):
+        return None
+    if not isinstance(data, dict):
+        return None
+    window = data.get("context_window_size")
+    if isinstance(window, bool) or not finite_positive(window):
+        return None
+    window_int = int(float(window))
+    if window_int <= 0:
+        return None
+    used = data.get("used_tokens")
+    if used is not None and not isinstance(used, bool):
+        try:
+            used_val = float(used)
+        except (TypeError, ValueError):
+            used_val = -1.0
+        if math.isfinite(used_val) and used_val >= 0:
+            return int(round(used_val)), window_int
+    percent = data.get("used_percentage")
+    if percent is not None and not isinstance(percent, bool):
+        try:
+            pct_val = float(percent)
+        except (TypeError, ValueError):
+            return None
+        if math.isfinite(pct_val) and pct_val >= 0:
+            return int(round(clamp_percent(pct_val) * window_int / 100.0)), window_int
+    return None
+
+
 COLLECTORS = {
     "codex": collect_codex,
     "claude": collect_claude,
     "pi": collect_pi,
     "hermes": collect_hermes,
+    "agy": collect_agy,
 }


