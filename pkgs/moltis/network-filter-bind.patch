+/// Return the socket address for the trusted-network proxy listener.
+///
+/// Binds `0.0.0.0:port` only when `bridge_clients` is true (container or VM
+/// sandboxes in a separate network namespace that reach the host via a bridge
+/// or vmnet gateway). Otherwise binds `127.0.0.1:port` so only local loopback
+/// clients can connect.
+pub fn proxy_listener_addr(bridge_clients: bool, port: u16) -> SocketAddr {
+    let ip = if bridge_clients {
+        Ipv4Addr::UNSPECIFIED
+    } else {
+        Ipv4Addr::LOCALHOST
+    };
+    SocketAddr::from((ip, port))
+}
+
+/// Select the proxy listener address from sandbox state and backend name.
+pub fn proxy_listener_addr_for_sandbox(
+    sandbox_enabled: bool,
+    backend_name: &str,
+    port: u16,
+) -> SocketAddr {
+    let bridge_clients = sandbox_enabled
+        && matches!(
+            backend_name,
+            "docker" | "podman" | "apple-container" | "firecracker"
+        );
+    proxy_listener_addr(bridge_clients, port)
+}
