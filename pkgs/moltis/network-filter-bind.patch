+    #[tokio::test]
+    async fn test_proxy_server_loopback_permits_and_rejects() {
+        use tokio::io::AsyncReadExt;
+        let upstream_listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        let upstream_port = upstream_listener.local_addr().unwrap().port();
+        tokio::spawn(async move {
+            if let Ok((mut sock, _)) = upstream_listener.accept().await {
+                let mut buf = [0u8; 4];
+                if sock.read_exact(&mut buf).await.is_ok() {
+                    let _ = sock.write_all(&buf).await;
+                }
+            }
+        });
+
+        let probe = TcpListener::bind(proxy_listener_addr(false, 0))
+            .await
+            .unwrap();
+        let proxy_addr = probe.local_addr().unwrap();
+        drop(probe);
+        assert_eq!(proxy_addr.ip(), IpAddr::V4(Ipv4Addr::LOCALHOST));
+
+        let allowed = vec!["127.0.0.1".to_string()];
+        let filter = Arc::new(DomainApprovalManager::new(
+            &allowed,
+            std::time::Duration::from_millis(10),
+        ));
+        let proxy = NetworkProxyServer::new(proxy_addr, filter, None);
+        let (shutdown_tx, shutdown_rx) = tokio::sync::watch::channel(false);
+        let proxy_task = tokio::spawn(async move { proxy.run(shutdown_rx).await });
+
+        let mut client = loop {
+            match TcpStream::connect(proxy_addr).await {
+                Ok(stream) => break stream,
+                Err(_) => tokio::time::sleep(std::time::Duration::from_millis(5)).await,
+            }
+        };
+        let connect_req =
+            format!("CONNECT 127.0.0.1:{upstream_port} HTTP/1.1\r\nHost: 127.0.0.1:{upstream_port}\r\n\r\n");
+        client.write_all(connect_req.as_bytes()).await.unwrap();
+        let mut reader = BufReader::new(client);
+        let mut status_line = String::new();
+        reader.read_line(&mut status_line).await.unwrap();
+        assert!(status_line.starts_with("HTTP/1.1 200"));
+        let mut blank = String::new();
+        reader.read_line(&mut blank).await.unwrap();
+        reader.get_mut().write_all(b"ping").await.unwrap();
+        let mut echoed = [0u8; 4];
+        reader.read_exact(&mut echoed).await.unwrap();
+        assert_eq!(&echoed, b"ping");
+
+        let mut denied_client = TcpStream::connect(proxy_addr).await.unwrap();
+        denied_client
+            .write_all(b"CONNECT denied.invalid:443 HTTP/1.1\r\nHost: denied.invalid:443\r\n\r\n")
+            .await
+            .unwrap();
+        let mut denied_reader = BufReader::new(denied_client);
+        let mut denied_status = String::new();
+        denied_reader.read_line(&mut denied_status).await.unwrap();
+        assert!(denied_status.starts_with("HTTP/1.1 403"));
+
+        let _ = shutdown_tx.send(true);
+        proxy_task.await.unwrap().unwrap();
+    }
