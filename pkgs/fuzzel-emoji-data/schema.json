{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fuzzel emoji master catalogue",
  "type": "object",
  "required": ["schemaVersion", "sources", "emojis"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "sources": { "type": "object", "additionalProperties": { "type": "object" } },
    "emojis": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/sequence" },
          {
            "type": "object",
            "required": ["displayName", "keywords", "searchKeywords", "skinTones", "tonePolicy", "variants"],
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1,
                "description": "Unicode name with one leading ASCII alphabetic prefix removed (^[A-Za-z]+:\\s*). Presentation cleanup converts curly quotes and en/em dashes to ASCII and removes trailing colons from alphabetic words. Accents remain intact."
              },
              "searchKeywords": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 },
                "description": "Ordered source enrichment words, deduplicated against normalised displayName and earlier words after presentation cleanup. Curly quotes and en/em dashes become ASCII, and alphabetic words lose trailing colons. Accents and existing ASCII aliases remain distinct. Leading ASCII alphabetic colon prefixes become searchable words. Group and subgroup values are never appended, but equivalent source keywords remain eligible."
              },
              "keywords": {
                "description": "Merged source phrases after existing normalisation and local overrides, before presentation cleanup.",
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "skinTones": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/tone" },
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "tonePolicy": { "enum": ["single", "default"] },
              "variants": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/sequence" },
                    {
                      "type": "object",
                      "required": ["tones"],
                      "properties": {
                        "tones": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "$ref": "#/$defs/tone" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "tone": { "enum": ["light", "medium-light", "medium", "medium-dark", "dark"] },
    "sequence": {
      "type": "object",
      "required": ["id", "emoji", "name", "group", "subgroup", "emojiVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9A-F]{4,6}(-[0-9A-F]{4,6})*$" },
        "emoji": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "subgroup": { "type": "string", "minLength": 1 },
        "emojiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
