{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fuzzel emoji master catalogue",
  "type": "object",
  "required": ["schemaVersion", "sources", "emojis"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": { "type": "object", "additionalProperties": { "type": "object" } },
    "emojis": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/sequence" },
          {
            "type": "object",
            "required": ["keywords", "skinTones", "tonePolicy", "variants"],
            "properties": {
              "keywords": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "skinTones": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/tone" },
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "tonePolicy": { "enum": ["single", "default"] },
              "variants": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/sequence" },
                    {
                      "type": "object",
                      "required": ["tones"],
                      "properties": {
                        "tones": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "$ref": "#/$defs/tone" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "tone": { "enum": ["light", "medium-light", "medium", "medium-dark", "dark"] },
    "sequence": {
      "type": "object",
      "required": ["id", "emoji", "name", "group", "subgroup", "emojiVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9A-F]{4,6}(-[0-9A-F]{4,6})*$" },
        "emoji": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "subgroup": { "type": "string", "minLength": 1 },
        "emojiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
