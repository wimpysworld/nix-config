+#[test]
+fn placeholder_style_uses_configured_font_size_and_opacity() {
+    let config = veila_common::AppConfig::from_toml_str(
+        r##"
+            [visuals.input]
+            font_size = 21
+
+            [visuals.placeholder]
+            color = "#f9e2af"
+            opacity = 100
+            font_size = 36
+        "##,
+    )
+    .expect("config");
+    let theme = ShellTheme::from_config(&config);
+    let shell = ShellState::new(theme.clone(), None, None, true);
+    let style = shell.placeholder_text_style();
+
+    assert_eq!(style.color.alpha, 255);
+    assert_eq!(style.font_size_px, Some(36));
+
+    let scaled = ShellState::new(theme.scaled_for_render(2), None, None, true);
+    assert_eq!(scaled.placeholder_text_style().font_size_px, Some(72));
+}
+
