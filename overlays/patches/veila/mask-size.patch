+#[test]
+fn mask_style_uses_configured_size_and_spacing() {
+    let config = veila_common::AppConfig::from_toml_str(
+        r#"
+            [visuals.input]
+            mask_size = 12
+            mask_spacing = 20
+        "#,
+    )
+    .expect("config");
+    let shell = ShellState {
+        render_scale: 2,
+        ..ShellState::new(ShellTheme::from_config(&config), None, None, true)
+    };
+    let style = shell.mask_style();
+
+    assert_eq!(style.bullet_size, 24);
+    assert_eq!(style.spacing, 40);
+    assert_eq!(style.horizontal_padding, 44);
+}
