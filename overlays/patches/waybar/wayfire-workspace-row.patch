Fix the Wayfire workspace row for clicks and scrolls.

Waybar 0.15.0 computes the target row as i / ws_h, but the column is
i % ws_w, so the row must be i / ws_w. On a grid wider than it is tall,
Wayfire rejects every workspace except the first with "Workspace
coordinates are too big!". Remove this patch when upstream fixes it.

diff --git a/src/modules/wayfire/workspaces.cpp b/src/modules/wayfire/workspaces.cpp
index 4c4cd6c..fa54547 100644
--- a/src/modules/wayfire/workspaces.cpp
+++ b/src/modules/wayfire/workspaces.cpp
@@ -75,7 +75,7 @@ auto Workspaces::handleScroll(GdkEventScroll* e) -> bool {
     auto n = wset.ws_w * wset.ws_h;
     auto i = (wset.ws_idx() + delta + n) % n;
     data["x"] = Json::Value((uint64_t)i % wset.ws_w);
-    data["y"] = Json::Value((uint64_t)i / wset.ws_h);
+    data["y"] = Json::Value((uint64_t)i / wset.ws_w);
     data["output-id"] = Json::Value((uint64_t)output.id);
   }
   ipc->send("vswitch/set-workspace", std::move(data));
@@ -109,7 +109,7 @@ auto Workspaces::update_box() -> void {
       btn.signal_pressed().connect([=, this] {
         Json::Value data;
         data["x"] = Json::Value((uint64_t)i % ws_w);
-        data["y"] = Json::Value((uint64_t)i / ws_h);
+        data["y"] = Json::Value((uint64_t)i / ws_w);
         data["output-id"] = Json::Value((uint64_t)output.id);
         ipc->send("vswitch/set-workspace", std::move(data));
       });
