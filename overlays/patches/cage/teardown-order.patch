@@ -83,0 +84,16 @@
+static void
+handle_backend_destroy(struct wl_listener *listener, void *data)
+{
+	struct cg_server *server = wl_container_of(listener, server, backend_destroy);
+	server->shutting_down = true;
+	server->backend = NULL;
+	wl_list_remove(&server->backend_destroy.link);
+	wl_list_remove(&server->new_output.link);
+	wl_list_init(&server->new_output.link);
+	if (server->seat) {
+		wl_list_remove(&server->seat->new_input.link);
+		wl_list_init(&server->seat->new_input.link);
+	}
+	server_terminate(server);
+}
